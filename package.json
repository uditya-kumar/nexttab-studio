{
  "name": "nexttab-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Instagram publishing, stats and comment-to-DM automation desk for @nexttab, built on the Zernio API",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,yellow \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.0",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
